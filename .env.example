# Copiez ce fichier en ".env" puis ajustez les valeurs.
# Volumes : de quelques milliers à plusieurs millions de lignes.
NB_CLIENTS=1000
NB_VENDEURS=50
NB_PRODUITS=200
NB_COMMANDES=5000
NB_AVIS=2000
NB_EVENEMENTS=20000

# Part de lignes "abîmées" volontairement (0.05 = 5 %)
TAUX_DEFAUTS=0.05

# Graine aléatoire : même graine = mêmes données à chaque lancement
SEED=42

# Dernier jour de la période simulée (les données couvrent les 365 jours avant)
DATE_FIN=2026-10-25

# Où écrire les fichiers, et niveau de détail des messages (DEBUG, INFO, WARNING)
DOSSIER_SORTIE=data
NIVEAU_LOG=INFO